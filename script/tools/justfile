# ─── script/tools/justfile — 工具聚合入口 ──────────────────────────────────
# 每个工具各自维护 justfile（唯一 go build 封装），这里只做转发。
# 产物统一在 script/bin/<工具>-<os>-<arch>。

set shell := ["bash", "-uc"]

_dir := justfile_directory()
_root := _dir / ".."
_bps_src := _dir / "bksmartpacker_v3"

_default:
    @just --list

# 构建全部工具（bksmartpacker 源码缺失时跳过）
build: build-cnb build-bps

# cnb：编译并发布为本地物料
build-cnb:
    @just --justfile {{_dir}}/cnb/justfile publish

# bksmartpacker：源码不入库，缺失则提示跳过
build-bps:
    @if [ -d {{_bps_src}}/cmd/bksmartpacker ]; then \
        just --justfile {{_bps_src}}/justfile build; \
     else \
        echo "  · 跳过 bksmartpacker（源码目录不存在: {{_bps_src}}）"; \
     fi

# 只编译不发布
build-cnb-only:
    @just --justfile {{_dir}}/cnb/justfile build

# 列出产物
list:
    @ls -lh {{_root}}/bin 2>/dev/null || echo "  （无产物，先 just build）"
