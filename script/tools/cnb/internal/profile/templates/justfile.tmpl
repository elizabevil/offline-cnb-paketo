# ─── {{.Name}} 子项目入口 ───────────────────────────────────────────────────
set dotenv-load := true

_dir := justfile_directory()
_profile := _dir / ".." / "config" / "projects" / "{{.Name}}.toml"

_default:
    @just --list

# 按流水线配置执行
build *args:
    @{{"{{"}}_dir{{"}}"}}/../script/run.sh --profile {{"{{"}}_profile{{"}}"}} {{"{{"}}args{{"}}"}}

# 只打印计划
plan:
    @{{"{{"}}_dir{{"}}"}}/../script/run.sh --profile {{"{{"}}_profile{{"}}"}} --dry-run
