#!/usr/bin/env bash
# {{.Name}} — 按流水线配置执行（配置：config/projects/{{.Name}}.toml）
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
repo="$(cd "${here}/.." && pwd)"
profile="${repo}/config/projects/{{.Name}}.toml"

case "${1:-}" in
  ""|-h|--help)
    if [ -z "${1:-}" ]; then exec "${repo}/script/run.sh" --profile "${profile}"; fi
    sed -n '3,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) exec "${repo}/script/run.sh" --profile "${profile}" "$@" ;;
esac
