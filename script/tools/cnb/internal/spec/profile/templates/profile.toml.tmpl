# {{.Name}} pipeline
#   validate: cnb pipeline profile validate {{.Dir}}/pipeline.toml
#   plan:     cnb pipeline plan {{.Dir}}/pipeline.toml
#   lint:     cnb lint {{.Dir}}/pipeline.toml
#   vars:     cnb pipeline variables {{.Dir}}/pipeline.toml

apiVersion = "cnb/v1"
kind       = "Pipeline"

[metadata]
name = "{{.Name}}"

# Placeholders use full config paths, so they are unambiguous:
#   ${spec.project.platform}       target platform          <- [spec.project] platform
#   ${spec.project.directory}      project directory        <- [spec.project] directory
#   ${spec.project.base}           base image for platform  <- [spec.project.base]
#   ${spec.assets.<id>.version}    material version         <- [spec.assets.<id>] version
#   ${derived.architecture}        amd64 / arm64            <- derived from platform
#   ${derived.container_platform}  linux/amd64              <- derived from platform
#   ${runtime.repo}                project root             <- --repo / CNB_REPO_ROOT
#   ${runtime.bundle}              material directory       <- --bundle or <lock dir>/bundle
# Unknown placeholders fail at plan time.

[spec.project]
directory = "{{.Dir}}"
platform  = "{{.Platform}}"

# Base image per platform; all stages build on it.
  [spec.project.base]
  {{.Platform}} = "{{.BaseImage}}"

# Versions locked by this project (omit to use the lock default).
[spec.assets.lifecycle]
version = "0.21.29"

[[spec.stages]]
name        = "base"
description = "build the base image (certificates, locale, workdir)"
workdir     = "{{.Dir}}"
run = [
  "{{.Container}}", "build", "-f", "docker/base.dockerfile",
  "-t", "{{.Name}}-base:${derived.architecture}",
  "--platform", "${derived.container_platform}",
  "--build-arg", "BASE_IMAGE=${spec.project.base}",
  ".",
]

[[spec.stages]]
name        = "builder"
description = "build the builder image (lifecycle + buildpacks)"
workdir     = "{{.Dir}}"
run = [
  "{{.Container}}", "build", "-f", "docker/builder.dockerfile",
  "-t", "{{.Name}}-builder:${derived.architecture}",
  "--platform", "${derived.container_platform}",
  "--build-context", "bundle=${runtime.bundle}",
  "--build-context", "buildpacks=${runtime.repo}/buildpacks",
  "--build-arg", "BASE_IMAGE_TAG={{.Name}}-base:${derived.architecture}",
  "--build-arg", "BUNDLE_ARCH=${spec.project.platform}",
  "--build-arg", "LIFECYCLE_VERSION=${spec.assets.lifecycle.version}",
  ".",
]

# Optional: run the four lifecycle phases inside the builder image.
# [[spec.stages]]
# name        = "lifecycle"
# description = "run detect/build/analyze/export inside the builder image"
# workdir     = "{{.Dir}}"
# run = [
#   "{{.Container}}", "run", "--rm",
#   "-e", "SOURCE_GET_URL=file:///workspace/source.tgz",
#   "-e", "OUTPUT_IMAGE={{.Name}}:${derived.architecture}",
#   "-e", "CNB_RUN_IMAGE=scratch",
#   "-v", "${runtime.repo}/app:/workspace:ro",
#   "-v", "${runtime.bundle}:/bundle:ro",
#   "{{.Name}}-builder:${derived.architecture}}",
# ]

# Static checks that cannot be derived from argv.
[[spec.checks.dockerfiles]]
path = "docker/base.dockerfile"

[[spec.checks.dockerfiles]]
path     = "docker/builder.dockerfile"
contexts = { bundle = "${runtime.bundle}", buildpacks = "${runtime.repo}/buildpacks" }
args     = { BUNDLE_ARCH = "${spec.project.platform}", LIFECYCLE_VERSION = "${spec.assets.lifecycle.version}" }
