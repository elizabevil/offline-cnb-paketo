# ─── {{.Name}} 流水线 ──────────────────────────────────────────────────────
# 结构：apiVersion / kind / metadata / spec（K8s 风格，TOML 格式）
# 顺序：spec.stages 列表顺序即执行顺序
# 校验：cnb pipeline profile validate config/projects/{{.Name}}.toml

apiVersion = "cnb/v1"
kind       = "Pipeline"

[metadata]
name = "{{.Name}}"

# ── 可用占位符（run 与 spec.checks 通用；未知占位符在 plan 阶段报错）──────
#   ${platform}            目标平台，如 linux-amd64        ← spec.project.platform
#   ${arch}                架构，如 amd64                  ← 由 platform 派生
#   ${oci_platform}        linux/amd64（docker --platform）← platform 首个 "-" 换成 "/"
#   ${base_image}          基础镜像                        ← spec.project.base[platform]
#   ${bundle}              物料目录绝对路径                ← --bundle 或 lock 同级 bundle/
#   ${repo}                仓库根绝对路径                  ← --repo / CNB_REPO_ROOT
#   ${asset.<id>.version}  物料版本                        ← spec.assets.<id>.version（缺省取 lock）
#   自省：cnb pipeline variables config/projects/<name>.toml

[spec.project]
dir      = "{{.Dir}}"
platform = "{{.Platform}}"

# ── 物料：本项目锁定的版本（省略则取 assets.lock.toml 的 default）──────────
[spec.assets.lifecycle]
version = "0.21.29"

# ── 阶段：一条命令 + 运行位置 ──────────────────────────────────────────────
[[spec.stages]]
name    = "base"
workdir = "."
run = [
  "podman", "build",
  "-f", "{{.Dir}}/docker/Dockerfile.base",
  "-t", "{{.Name}}-base:latest",
  "--build-arg", "BASE_IMAGE={{.BaseImage}}",
  ".",
]
