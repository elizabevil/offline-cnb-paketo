# {{.Name}} base image: every stage builds on it.
# BASE_IMAGE comes from [spec.project.base] via --build-arg.
# Install only what all builds need (certs, tzdata, common tools).
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Example (package manager differs: apt on debian/ubuntu, apk on alpine):
# RUN apt-get update \
#  && apt-get install -y --no-install-recommends ca-certificates tzdata \
#  && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8
WORKDIR /workspace
