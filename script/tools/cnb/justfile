# ─── script/tools/cnb/justfile — cnb 构建（唯一封装 go build 的地方）──────
# 产物：script/bin/cnb-<os>-<arch>，CGO_ENABLED=0 静态链接
# 用法：just --justfile script/tools/cnb/justfile build
#       TARGET=linux-arm64 just --justfile script/tools/cnb/justfile build

set shell := ["bash", "-uc"]

_dir := justfile_directory()
_root := _dir / "../.."
_out := _root / "bin"
_ver := "3.0.0"

_host_arch := if arch() == "x86_64" { "amd64" } else if arch() == "aarch64" { "arm64" } else { arch() }
_host := os() + "-" + _host_arch
target := env_var_or_default("TARGET", _host)
name := "cnb-" + target
bin := _out / name

_default:
    @just --list

# 编译到 script/bin/<name>（唯一 go build 入口）
build:
    @mkdir -p {{ _out }}
    @cd {{ _dir }} && \
      CGO_ENABLED=0 \
      GOOS=$(echo '{{ target }}' | cut -d- -f1) \
      GOARCH=$(echo '{{ target }}' | cut -d- -f2) \
      go build -trimpath -buildvcs=false \
        -ldflags "-extldflags '-static' -X learn-cnb-paketo/tools/cnb/internal/version.Version={{ _ver }} -s -w" \
        -o {{ bin }} ./cmd/cnb
    @{{ bin }} version

# 编译并发布为本地物料（供镜像构建 COPY）
publish: build
    @{{ bin }} --file {{ _root }}/../project/assets.toml materials publish cnb >/dev/null
    @echo "  ✓ cnb 物料已发布"


# lifecycle singleton 复现：非 root 应不触发，root-owned socket 应触发
test-singleton:
    @cd {{ _dir }}/tests/lifecycle-singleton && go run .
    @cd {{ _dir }}/tests/lifecycle-singleton && go build -o /tmp/lifecycle-singleton .
    @podman unshare /tmp/lifecycle-singleton


# Podman 兼容 API 并发导出探测（需要 root/rootful podman）
test-podman-export:
    @sudo {{ _dir }}/tests/podman-export-probe.sh
