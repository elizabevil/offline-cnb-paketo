# ─── script/justfile — 基座编排入口 ─────────────────────────────────────────
# 被仓库根目录 justfile import；也可在 script/ 下直接 `just`。
#
# 设计原则：just 只做「参数转发 + 展示」，真正的逻辑在 script/bin/cnb-linux-amd64。
# 这样同一套能力可以被 CI、容器、其他脚本直接复用，不依赖 just。
#
# ⚠️ 路径语义：import 进来之后 `justfile_directory()` 指向仓库根，
#    而 `source_directory()` 指向本文件所在目录。基座内部一律用后者。
#
# 平台切换（三种写法等价）：
#   just platform=linux-arm64 fetch
#   PLATFORM=linux-arm64 just fetch
#   just fetch --platform linux-arm64

set shell := ["bash", "-uc"]

# 目标平台；可用 `just platform=linux-arm64 <recipe>` 覆盖
platform := env_var_or_default("PLATFORM", "linux-amd64")
# 代理；默认读环境变量，也可在仓库根 .env 中设置 PROXY_URL
proxy := env_var_or_default("PROXY_URL", "")

_script := source_directory()

# cnb 的手动版本号（发版时改这一处；git/架构信息由 buildinfo 自动采集）
_cnb_version := "3.0.0"

# go 可能只存在于交互式 shell 的 PATH（just 用非交互 bash），这里显式探测。
# 也可用环境变量覆盖：GO=/path/to/go just tools
_go := env_var_or_default("GO", shell(_script + "/lib/go.sh"))
_tools_just := _script / "tools" / "justfile"
# 工具产物命名：<工具>-<os>-<arch>
_cnb_bin := env_var_or_default("CNB_BIN", _script / "bin" / "cnb-linux-amd64")

# ── 视图 ────────────────────────────────────────────────────────────────────

# 物料清单（TSV：id / version / 解包方式 / 平台）
list:
    @{{_cnb_bin}} --platform {{platform}} --file {{_script}}/../project/assets.toml materials list

# 物料自检：落盘状态、哈希、解压产物
doctor:
    @{{_cnb_bin}} --platform {{platform}} --file {{_script}}/../project/assets.toml materials verify

# 编译工具（cnb / bksmartpacker）到 script/bin/<工具>-<os>-<arch>
tools:
    @just --justfile {{_tools_just}} build

# 基座结构自检：lock 结构 + shell 语法 + go 静态检查
check: tools
    @echo "── lock 结构 ──"
    @{{_cnb_bin}} --file {{_script}}/../project/assets.toml materials validate
    @echo "── 模板合法性（渲染内嵌模板后校验）──"
    @tmp=$(mktemp -d); \
      {{_cnb_bin}} init tmpl-check --config "$tmp/pipeline.toml" --assets "$tmp/assets.toml" >/dev/null && \
      {{_cnb_bin}} pipeline profile validate "$tmp/pipeline.toml" >/dev/null && \
      {{_cnb_bin}} materials validate --file "$tmp/assets.toml" >/dev/null && \
      echo "  ✓ 模板渲染后通过 profile / materials 校验"; \
      rm -rf "$tmp"
    @echo "── shell 语法 ──"
    @bash -n {{_script}}/ci.sh {{_script}}/check-updates.sh && echo "  ✓ bash -n 通过"
    @echo "── go 静态检查 ──"
    @cd {{_script}}/tools/cnb && test -z "$(gofmt -l .)" && echo "  ✓ gofmt 无差异"
    @cd {{_script}}/tools/cnb && \
      GOCACHE="${GOCACHE:-{{_script}}/../.cache/go-build}" {{_go}} vet ./... && echo "  ✓ go vet 通过"
    @echo "── 协议边界 ──"
    @cd {{_script}}/tools/cnb && \
      bad=$(grep -rn 'toml.Unmarshal' --include='*.go' internal \
        | grep -v '^internal/spec/' \
        | grep -v '^internal/profile/' || true); \
      if [ -n "$bad" ]; then echo "  ✗ 只允许 spec 包解析 TOML:"; echo "$bad"; exit 1; fi; \
      echo "  ✓ TOML 解析只在 spec 包"
    @cd {{_script}}/tools/cnb && \
      bad=$(grep -rn 'BKS_\|app_desc\|cnb-image-layers' --include='*.go' internal || true); \
      if [ -n "$bad" ]; then echo "  ✗ 通用包不得出现平台私有协议:"; echo "$bad"; exit 1; fi; \
      echo "  ✓ internal 无平台私有协议"

    @echo "── Go 语言约束 ──"
    @cd {{_script}}/tools/cnb && \
      bad=$(grep -rn 'io/ioutil' --include='*.go' . || true); \
      if [ -n "$bad" ]; then echo "  ✗ 禁止 io/ioutil:"; echo "$bad"; exit 1; fi; \
      echo "  ✓ 无 io/ioutil"
    @cd {{_script}}/tools/cnb && \
      bad=$(find internal cmd -type d \( -name util -o -name common -o -name misc -o -name types -o -name api \) 2>/dev/null || true); \
      if [ -n "$bad" ]; then echo "  ✗ 禁止无意义包名:"; echo "$bad"; exit 1; fi; \
      echo "  ✓ 包名无 util/common/misc/types/api"
    @cd {{_script}}/.. && \
      for f in project/*/pipeline.toml; do \
        grep -q "── 占位符" "$f" || { echo "  ✗ $f 缺少占位符说明（配置必须自带占位符说明）"; exit 1; }; \
      done; \
      echo "  ✓ 配置必须自带占位符说明"
    @cd {{_script}}/tools/cnb && \
      bad=$(grep -rnE 'errs\.(New|Wrap|Invalid|NotFound|Missing).*"[^"]*[一-龥]' --include='*.go' internal cmd || true); \
      if [ -n "$bad" ]; then echo "  ✗ 错误信息必须为英文:"; echo "$bad"; exit 1; fi; \
      echo "  ✓ 错误信息为英文"
    @cd {{_script}}/tools/cnb && \
      bad=$(grep -rn '[\u4e00-\u9fa5]' --include='*.go' internal/cli internal/checks || true); \
      if [ -n "$bad" ]; then echo "  ✗ CLI/检查层不得出现中文:"; echo "$bad"; exit 1; fi; \
      echo "  ✓ CLI/检查层无中文"
    @cd {{_script}}/tools/cnb && \
      bad=$(grep -rn 'tlsunsafeekm\|tlsrsakex\|tls3des\|tls10server\|x509keypairleaf\|gotypesalias' --include='*.go' . || true); \
      if [ -n "$bad" ]; then echo "  ✗ 禁止已移除的 GODEBUG:"; echo "$bad"; exit 1; fi; \
      echo "  ✓ 无已移除的 GODEBUG"

    @echo "── go 单测 ──"
    @cd {{_script}}/tools/cnb && \
      GOCACHE="${GOCACHE:-{{_script}}/../.cache/go-build}" {{_go}} test ./...
    @if command -v shellcheck >/dev/null 2>&1; then \
      echo "── shellcheck ──"; \
      shellcheck -S warning {{_script}}/ci.sh {{_script}}/check-updates.sh && echo "  ✓ shellcheck 通过"; \
    else \
      echo "  · shellcheck 未安装，跳过"; \
    fi

# ── 物料 ────────────────────────────────────────────────────────────────────

# 下载 + 校验 + 解包（不给 id 则全部）
fetch *ids:
    @{{_cnb_bin}} --platform {{platform}} materials sync {{ids}}

# 校验哈希与解压产物
verify *ids:
    @{{_cnb_bin}} --platform {{platform}} --file {{_script}}/../project/assets.toml materials verify {{ids}}

# 由本地归档反推 sha256（打印片段，人工回填 lock）
pin *ids:
    @{{_cnb_bin}} --platform {{platform}} --file {{_script}}/../project/assets.toml materials pin {{ids}}

# 镜像归档格式转换：oci-layout ↔ docker-archive
convert src dst *args:
    @{{_cnb_bin}} image convert {{src}} {{dst}} {{args}}


# ── 维护 ────────────────────────────────────────────────────────────────────

# 清空当前平台的全部物料（危险）
[confirm]
clean:
    @rm -rf "{{_script}}/../bundle/{{platform}}"
    @echo "  ✓ 已清空 bundle/{{platform}}（归档 + 二进制 + SDK）"

# 对照上游最新版
check-updates:
    @{{_script}}/check-updates.sh

# Go 静态检查（golangci-lint，配置见 script/tools/.golangci.yml）
lint:
    @cd {{_script}}/tools/cnb && \
      GOCACHE={{_script}}/../.cache/go-build \
      GOMODCACHE={{_script}}/../.cache/gomod \
      GOLANGCI_LINT_CACHE={{_script}}/../.cache/golangci \
      golangci-lint run --config ../.golangci.yml ./...
