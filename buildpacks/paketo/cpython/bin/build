#!/bin/sh

# 应用目录：优先 CNB_APP_DIR，其次常见挂载点（/workspace 或 /app）
resolve_app_dir() {
  if [ -n "${CNB_APP_DIR:-}" ]; then echo "${CNB_APP_DIR}"; return; fi
  # lifecycle 执行 buildpack 时 cwd 就是应用目录（/cnb/* 除外）
  case "$(pwd)" in
    /cnb/*) ;;
    *) echo "$(pwd)"; return ;;
  esac
  for d in /workspace /app; do [ -d "$d" ] && { echo "$d"; return; }; done
  echo /workspace
}

set -euo pipefail
layers_dir="${1:?missing layers dir}"
app_dir="$(resolve_app_dir)"
# 版本优先级：BP_CPYTHON_VERSION > runtime.txt（python-X.Y.Z）> 默认
# 兼容旧名 BP_PYTHON_VERSION
if [ -n "${BP_PYTHON_VERSION:-}" ] && [ -z "${BP_CPYTHON_VERSION:-}" ]; then
  echo "  ⚠ BP_PYTHON_VERSION 已弃用，请改用 BP_CPYTHON_VERSION" >&2
  BP_CPYTHON_VERSION="${BP_PYTHON_VERSION}"
fi
if [ -z "${BP_CPYTHON_VERSION:-}" ] && [ -f "${app_dir}/runtime.txt" ]; then
  BP_CPYTHON_VERSION="$(sed -n 's/^python-//p' "${app_dir}/runtime.txt" | head -1 | tr -d '[:space:]')"
fi
version="${BP_CPYTHON_VERSION:-3.12}"
root="$(dirname "${layers_dir}")"
layer="${layers_dir}/python"
cache="${CNB_CACHE_DIR:-/layers/cache}/python"
mkdir -p "${layer}/bin" "${layer}/env" "${cache}"

py=""
install_root="${cache}/install"   # 解释器持久缓存（跨构建复用）
mkdir -p "${install_root}"

# 1) 挂载的本地运行时
cand="${CNB_RUNTIME_DIR:-/cnb/runtimes}/python/${version}/bin/python3"
[ -x "${cand}" ] && py="${cand}"

# 2) 缓存里已有
if [ -z "${py}" ]; then
  py="$(ls -d "${install_root}"/*/bin/python3 2>/dev/null | head -1 || true)"
  [ -n "${py}" ] && echo "  ⏭️  cache hit: ${py}" >&2
fi

# 3) 下载到缓存（不是 layer）
if [ -z "${py}" ]; then
  export UV_CACHE_DIR="${cache}"
  export UV_PYTHON_INSTALL_DIR="${install_root}"
  export UV_PYTHON_INSTALL_MIRROR="${UV_PYTHON_INSTALL_MIRROR:-https://gh-proxy.com/https://github.com/astral-sh/python-build-standalone/releases/download}"
  echo "  ⬇️  uv python install ${version} (install-dir=${install_root})" >&2
  echo "  mirror: ${UV_PYTHON_INSTALL_MIRROR}" >&2
  if [ -n "${UV_PYTHON_DOWNLOADS_JSON_URL:-}" ]; then
    echo "  metadata: ${UV_PYTHON_DOWNLOADS_JSON_URL}" >&2
  fi
  uv python install "${version}" >&2 || true
  py="$(ls -d "${install_root}"/*/bin/python3 2>/dev/null | head -1 || true)"
fi
[ -n "${py}" ] || { echo "  ✗ cpython not available（缓存 ${install_root}）" >&2; exit 1; }

# 把解释器树直接铺进层根：bin/python3 是实体文件，
# venv 里的软链指向它时才不会随 subPath 变化而失效
src_root="$(dirname "$(dirname "${py}")")"
if [ -d "${src_root}" ] && [ "$(dirname "${src_root}")" = "${install_root}" ]; then
  [ -x "${layer}/bin/python3" ] || cp -a "${src_root}/." "${layer}/" 2>/dev/null || true
  [ -x "${layer}/bin/python3" ] && py="${layer}/bin/python3"
fi
[ -n "${py}" ] || { echo "  ✗ python not found" >&2; exit 1; }

# python3 已是实体文件时，只补 python 别名
if [ "$(readlink -f "${py}")" != "$(readlink -f "${layer}/bin/python3" 2>/dev/null)" ]; then
  ln -sf "$(readlink -f "${py}")" "${layer}/bin/python3"
fi
ln -sf python3 "${layer}/bin/python"
printf '%s' "${layer}/bin" > "${layer}/env/PATH.prepend"
printf '%s' ":" > "${layer}/env/PATH.delim"
# launcher 会 source profile.d；作为 layer env 之外的双保险
mkdir -p "${layer}/profile.d"
cat > "${layer}/profile.d/000_python_path.sh" <<PROFILE
export PATH="${layer}/bin:\${PATH}"
PROFILE
# 部分运行时直接 source $HOME/.profile.d
mkdir -p "${app_dir}/.profile.d"
printf 'export PATH="%s/bin:$PATH"\n' "${layer}" > "${app_dir}/.profile.d/000_python_path.sh"
cat > "${layer}.toml" <<TOML
[types]
launch = true
build  = true
cache  = true
TOML
ver="$("${py}" --version 2>&1 | awk '{print $2}')"
cat > "${layer}.sbom.cdx.json" <<JSON
{ "bomFormat": "CycloneDX", "specVersion": "1.5",
  "components": [{ "type": "application", "name": "python", "version": "${ver}",
    "purl": "pkg:generic/python@${ver}" }] }
JSON
arch_now="${CNB_TARGET_ARCH:-$(uname -m)}"; case "${arch_now}" in x86_64) arch_now=amd64;; aarch64) arch_now=arm64;; esac
echo "  ✅ cpython complete: python${ver} linux/${arch_now}" >&2
