#!/bin/sh
# build — 自建 Procfile buildpack：把 Procfile 转成 launch.toml 的 process 定义。
#
# Procfile 每行形如 `web: command --flag`，转换为：
#   [[processes]]
#   type = "web"
#   command = ["command", "--flag"]
#   default = true
set -eu

app="${CNB_APP_DIR:-/app}"
layers="${1:-${CNB_LAYERS_DIR:-/layers}}"
procfile="${app}/Procfile"

if [ ! -f "${procfile}" ]; then
  echo "build: no Procfile, skip" >&2
  exit 0
fi

out="${layers}/launch.toml"
: > "${out}"
first=1

while IFS= read -r line || [ -n "${line}" ]; do
  case "${line}" in
    ''|'#'*) continue ;;
  esac
  case "${line}" in
    *:*) ;;
    *) echo "build: invalid Procfile line: ${line}" >&2; continue ;;
  esac
  type="${line%%:*}"
  cmd="${line#*:}"
  type="$(echo "${type}" | tr -d '[:space:]')"
  cmd="$(echo "${cmd}" | sed 's/^[[:space:]]*//')"
  [ -n "${type}" ] && [ -n "${cmd}" ] || continue

  {
    echo "[[processes]]"
    echo "type = \"${type}\""
    printf 'command = ['
    sep=""
    for w in ${cmd}; do
      printf '%s"%s"' "${sep}" "${w}"
      sep=","
    done
    echo "]"
    if [ "${first}" = "1" ]; then
      echo "default = true"
      first=0
    fi
    echo
  } >> "${out}"
  echo "build: process ${type} = ${cmd}" >&2
done < "${procfile}"

[ -s "${out}" ] || { echo "build: no valid process entries" >&2; exit 1; }
echo "build: wrote ${out}" >&2
