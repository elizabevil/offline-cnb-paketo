#!/bin/sh
# build — 官方 Paketo Procfile buildpack (5.13.4)
# 此文件在 Docker 构建时通过 multi-stage COPY 替换为
# paketobuildpacks/procfile:5.13.4 中的原始文件 —— 详见 Dockerfile。
#
# 本地测试: podman run --rm -v $(pwd):/workspace
#   swr.cn-north-4...../paketobuildpacks/procfile:5.13.4 /cnb/buildpacks/paketo-buildpacks_procfile/5.13.4/bin/build


# 应用目录：优先 CNB_APP_DIR，其次常见挂载点（/workspace 或 /app）
resolve_app_dir() {
  if [ -n "${CNB_APP_DIR:-}" ]; then echo "${CNB_APP_DIR}"; return; fi
  # lifecycle 执行 buildpack 时 cwd 就是应用目录（/cnb/* 除外）
  case "$(pwd)" in
    /cnb/*) ;;
    *) echo "$(pwd)"; return ;;
  esac
  for d in /workspace /app; do [ -d "$d" ] && { echo "$d"; return; }; done
  echo /workspace
}

echo "build: use official Paketo Procfile buildpack image"
exit 0
