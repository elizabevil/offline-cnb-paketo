#!/bin/sh

# 应用目录：优先 CNB_APP_DIR，其次常见挂载点（/workspace 或 /app）
resolve_app_dir() {
  if [ -n "${CNB_APP_DIR:-}" ]; then echo "${CNB_APP_DIR}"; return; fi
  # lifecycle 执行 buildpack 时 cwd 就是应用目录（/cnb/* 除外）
  case "$(pwd)" in
    /cnb/*) ;;
    *) echo "$(pwd)"; return ;;
  esac
  for d in /workspace /app; do [ -d "$d" ] && { echo "$d"; return; }; done
  echo /workspace
}

set -euo pipefail
layers_dir="${1:?missing layers dir}"
app_dir="$(resolve_app_dir)"
# 版本优先级：BP_GO_VERSION > go.mod 的 go 指令（补齐为 x.y.0）> 默认
version="${BP_GO_VERSION:-}"
if [ -z "${version}" ] && [ -f "${app_dir:-/workspace}/go.mod" ]; then
  v="$(awk '/^go /{print $2; exit}' "${app_dir:-/workspace}/go.mod" 2>/dev/null || true)"
  case "${v}" in
    *.*.*) version="${v}" ;;
    *.*) version="${v}.0" ;;
  esac
fi
version="${version:-1.27.4}"
root="$(dirname "${layers_dir}")"
layer="${layers_dir}/go"
cache="${CNB_CACHE_DIR:-/layers/cache}/go"
download="${cache}/download"; sdk="${cache}/sdk"
mkdir -p "${layer}/bin" "${layer}/env" "${download}" "${sdk}"

# 1) 挂载的本地运行时 2) 缓存里的 SDK 3) 下载
# 挂载目录名允许是 1.21 或 1.21.0：按 major.minor 前缀匹配
major_minor="$(echo "${version}" | cut -d. -f1-2)"
go_root=""
runtime_root="${CNB_RUNTIME_DIR:-/cnb/runtimes}/go"
# 缓存目录按版本命名（go<version>），避免不同版本互相复用
cached="${sdk}/go${version}"
for cand in "${runtime_root}/${version}" \
            "$(ls -d "${runtime_root}/${major_minor}"* 2>/dev/null | sort -V | tail -1)" \
            "${cached}" \
            "$(ls -d "${sdk}/go${major_minor}"* 2>/dev/null | sort -V | tail -1)"; do
  [ -n "${cand}" ] || continue
  if [ -x "${cand}/bin/go" ]; then
    go_root="${cand}"
    case "${cand}" in
      "${runtime_root}"/*) echo "  📦 使用挂载的 Go SDK: ${cand}" >&2 ;;
      *)                   echo "  ⏭️  使用缓存的 Go SDK: ${cand}" >&2 ;;
    esac
    break
  fi
done
if [ -z "${go_root}" ]; then
  arch="$(uname -m)"; case "${arch}" in x86_64) arch=amd64;; aarch64) arch=arm64;; esac
  # 下载源可配置：BP_GO_MIRROR（默认阿里云）→ 官方 go.dev 兜底
  mirror="${BP_GO_MIRROR:-}"
  if [ -z "${mirror}" ] && [ -f /cnb/go-mirror ]; then
    mirror="$(cat /cnb/go-mirror 2>/dev/null || true)"
  fi
  mirror="${mirror:-https://mirrors.aliyun.com/golang/}"
  mirrors="${mirror} https://go.dev/dl/"
  ok=""
  for base in ${mirrors}; do
    url="${base%/}/go${version}.linux-${arch}.tar.gz"
    echo "  ⬇️  ${url}" >&2
    if mkdir -p "${sdk}/go${version}" && \
       curl -fsSL --connect-timeout 15 --retry 2 "${url}" | tar -xz --strip-components=1 -C "${sdk}/go${version}" 2>/dev/null; then
      ok=1; break
    fi
    echo "  · 失败，尝试下一个源" >&2
  done
  [ -n "${ok}" ] || { echo "  ✗ 所有下载源均失败（可设 BP_GO_MIRROR）" >&2; exit 1; }
  go_root="${sdk}/go${version}"
fi

ln -sf "${go_root}/bin/go" "${layer}/bin/go"
ln -sf "${go_root}/bin/gofmt" "${layer}/bin/gofmt"
echo "${layer}/bin" > "${layer}/env/PATH.prepend"
echo "${go_root}" > "${layer}/env/GOROOT.default"
# Go SDK 只在构建期需要，不需要进入产物镜像
cat > "${layer}.toml" <<TOML
[types]
build  = true
cache  = true
TOML
ver="$("${go_root}/bin/go" version 2>/dev/null | awk '{print $3}' | tr -d 'go')"
cat > "${layer}.sbom.cdx.json" <<JSON
{ "bomFormat": "CycloneDX", "specVersion": "1.5",
  "components": [{ "type": "application", "name": "go", "version": "${ver}",
    "purl": "pkg:generic/go@${ver}" }] }
JSON
arch_now="$(uname -m)"; case "${arch_now}" in x86_64) arch_now=amd64;; aarch64) arch_now=arm64;; esac
echo "  ✅ go-dist complete: go${ver} linux/${arch_now} (GOROOT=${go_root})" >&2
