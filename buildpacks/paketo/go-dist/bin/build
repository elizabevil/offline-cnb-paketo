#!/bin/sh
set -euo pipefail
layers_dir="${1:?missing layers dir}"
app_dir="${CNB_APP_DIR:-/workspace}"
# 版本优先级：BP_GO_VERSION > go.mod 的 go 指令（补齐为 x.y.0）> 默认
version="${BP_GO_VERSION:-}"
if [ -z "${version}" ] && [ -f "${app_dir:-/workspace}/go.mod" ]; then
  v="$(awk '/^go /{print $2; exit}' "${app_dir:-/workspace}/go.mod" 2>/dev/null || true)"
  case "${v}" in
    *.*.*) version="${v}" ;;
    *.*) version="${v}.0" ;;
  esac
fi
version="${version:-1.27.4}"
root="$(dirname "${layers_dir}")"
layer="${layers_dir}/go"
cache="${CNB_CACHE_DIR:-/layers/cache}/go"
download="${cache}/download"; sdk="${cache}/sdk"
mkdir -p "${layer}/bin" "${layer}/env" "${download}" "${sdk}"

# 1) 挂载的本地运行时 2) 缓存里的 SDK 3) 下载
go_root=""
for cand in "${CNB_RUNTIME_DIR:-/cnb/runtimes}/go/${version}" \
            "$(ls -d "${sdk}"/go* 2>/dev/null | sort -V | tail -1)"; do
  [ -x "${cand}/bin/go" ] && { go_root="${cand}"; break; }
done
if [ -z "${go_root}" ]; then
  arch="$(uname -m)"; case "${arch}" in x86_64) arch=amd64;; aarch64) arch=arm64;; esac
  # 下载源可配置：BP_GO_MIRROR（默认阿里云）→ 官方 go.dev 兜底
  mirrors="${BP_GO_MIRROR:-https://mirrors.aliyun.com/golang/} https://go.dev/dl/"
  ok=""
  for base in ${mirrors}; do
    url="${base%/}/go${version}.linux-${arch}.tar.gz"
    echo "  ⬇️  ${url}" >&2
    if curl -fsSL --connect-timeout 15 --retry 2 "${url}" | tar -xz -C "${sdk}" 2>/dev/null; then
      ok=1; break
    fi
    echo "  · 失败，尝试下一个源" >&2
  done
  [ -n "${ok}" ] || { echo "  ✗ 所有下载源均失败（可设 BP_GO_MIRROR）" >&2; exit 1; }
  go_root="${sdk}/go"
fi

ln -sf "${go_root}/bin/go" "${layer}/bin/go"
ln -sf "${go_root}/bin/gofmt" "${layer}/bin/gofmt"
echo "${layer}/bin" > "${layer}/env/PATH.prepend"
echo "${go_root}" > "${layer}/env/GOROOT.default"
# Go SDK 只在构建期需要，不需要进入产物镜像
cat > "${layer}.toml" <<TOML
[types]
build  = true
cache  = true
TOML
ver="$("${go_root}/bin/go" version 2>/dev/null | awk '{print $3}' | tr -d 'go')"
cat > "${layer}.sbom.cdx.json" <<JSON
{ "bomFormat": "CycloneDX", "specVersion": "1.5",
  "components": [{ "type": "application", "name": "go", "version": "${ver}",
    "purl": "pkg:generic/go@${ver}" }] }
JSON
echo "  ✅ go-dist complete (${ver})" >&2
