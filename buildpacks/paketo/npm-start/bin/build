#!/bin/sh

# 应用目录：优先 CNB_APP_DIR，其次常见挂载点（/workspace 或 /app）
resolve_app_dir() {
  if [ -n "${CNB_APP_DIR:-}" ]; then echo "${CNB_APP_DIR}"; return; fi
  # lifecycle 执行 buildpack 时 cwd 就是应用目录（/cnb/* 除外）
  case "$(pwd)" in
    /cnb/*) ;;
    *) echo "$(pwd)"; return ;;
  esac
  for d in /workspace /app; do [ -d "$d" ] && { echo "$d"; return; }; done
  echo /workspace
}

set -euo pipefail
layers_dir="${1:?missing layers dir}"
# layers_dir 是本 buildpack 私有目录 /layers/<id>，其父目录才是 layers 根
root="$(dirname "${layers_dir}")"
node_bin="$(ls -d "${root}"/*/node/bin 2>/dev/null | head -1 || true)"
mods="$(ls -d "${root}"/*/node_modules 2>/dev/null | head -1 || true)"
cat > "${layers_dir}/launch.toml" <<TOML
[[processes]]
  type = "web"
  command = ["/bin/sh", "-c", "PATH=${node_bin}:${mods}/.bin:\$PATH npm start"]
  default = true
TOML
echo "  ✅ npm-start: web process registered" >&2
