#!/bin/sh

# 应用目录：优先 CNB_APP_DIR，其次常见挂载点（/workspace 或 /app）
resolve_app_dir() {
  if [ -n "${CNB_APP_DIR:-}" ]; then echo "${CNB_APP_DIR}"; return; fi
  # lifecycle 执行 buildpack 时 cwd 就是应用目录（/cnb/* 除外）
  case "$(pwd)" in
    /cnb/*) ;;
    *) echo "$(pwd)"; return ;;
  esac
  for d in /workspace /app; do [ -d "$d" ] && { echo "$d"; return; }; done
  echo /workspace
}

set -euo pipefail
layers_dir="${1:?missing layers dir}"
app_dir="$(resolve_app_dir)"
root="$(dirname "${layers_dir}")"
layer="${layers_dir}/site-packages"
cache="${CNB_CACHE_DIR:-/layers/cache}/python"
mkdir -p "${layer}/env" "${cache}"

py_bin="$(ls -d "${root}"/*/python/bin 2>/dev/null | head -1)"
[ -n "${py_bin}" ] || { echo "  ✗ 未找到 python 层" >&2; exit 1; }
export PATH="${py_bin}:${PATH}"
export UV_CACHE_DIR="${cache}/uv"
# 源可配置：默认清华 PyPI，可用 UV_INDEX_URL 覆盖
export UV_INDEX_URL="${UV_INDEX_URL:-https://pypi.tuna.tsinghua.edu.cn/simple}"
echo "  index: ${UV_INDEX_URL}" >&2

venv="${layer}/venv"
[ -x "${venv}/bin/python" ] || uv venv --relocatable --python "${py_bin}/python3" "${venv}" >&2

cd "${app_dir}"
if [ -f requirements.txt ]; then
  uv pip install --index-url "${UV_INDEX_URL}" --python "${venv}/bin/python" -r requirements.txt >&2
elif [ -f pyproject.toml ]; then
  uv pip install --index-url "${UV_INDEX_URL}" --python "${venv}/bin/python" . >&2
fi

[ -d .venv ] || true
echo "${layer}/venv/bin" > "${layer}/env/PATH.prepend"
cat > "${layer}.toml" <<TOML
[types]
launch = true
build  = true
cache  = true
TOML
cat > "${layer}.sbom.cdx.json" <<'JSON'
{ "bomFormat": "CycloneDX", "specVersion": "1.5", "components": [] }
JSON

# 启动进程：venv 优先，其次 python
if [ -f app.py ]; then cmd="python app.py"
elif [ -f main.py ]; then cmd="python main.py"
else cmd="python app.py"; fi
cat > "${layers_dir}/launch.toml" <<TOML
[[processes]]
  type = "web"
  command = ["/bin/sh", "-c", "PATH=${layer}/venv/bin:${py_bin}:\$PATH exec ${cmd}"]
  default = true
TOML
echo "  ✅ pip-install complete" >&2
