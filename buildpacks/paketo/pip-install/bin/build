#!/bin/sh

# 应用目录：优先 CNB_APP_DIR，其次常见挂载点（/workspace 或 /app）
resolve_app_dir() {
  if [ -n "${CNB_APP_DIR:-}" ]; then echo "${CNB_APP_DIR}"; return; fi
  # lifecycle 执行 buildpack 时 cwd 就是应用目录（/cnb/* 除外）
  case "$(pwd)" in
    /cnb/*) ;;
    *) echo "$(pwd)"; return ;;
  esac
  for d in /workspace /app; do [ -d "$d" ] && { echo "$d"; return; }; done
  echo /workspace
}

set -euo pipefail
layers_dir="${1:?missing layers dir}"
app_dir="$(resolve_app_dir)"
root="$(dirname "${layers_dir}")"
layer="${layers_dir}/site-packages"
cache="${CNB_CACHE_DIR:-/layers/cache}/python"
mkdir -p "${layer}/env" "${cache}"

py_bin="$(ls -d "${root}"/*/python/bin 2>/dev/null | head -1)"
[ -n "${py_bin}" ] || { echo "  ✗ 未找到 python 层" >&2; exit 1; }
export PATH="${py_bin}:${PATH}"
export UV_CACHE_DIR="${cache}/uv"
# 源与本地 wheels 都可配置：
#   UV_INDEX_URL / PIP_INDEX_URL      主索引
#   UV_EXTRA_INDEX_URL                额外索引
#   PIP_FIND_LINKS / 自动探测 pkgs/   本地 wheel 目录
#   UV_NO_INDEX=1                     只从 find-links 安装
index="${UV_INDEX_URL:-${PIP_INDEX_URL:-https://pypi.tuna.tsinghua.edu.cn/simple}}"
find_links="${PIP_FIND_LINKS:-}"
if [ -z "${find_links}" ] && [ -d "${app_dir}/pkgs" ]; then
  find_links="${app_dir}/pkgs"
fi
echo "  index: ${index}" >&2
[ -n "${find_links}" ] && echo "  find-links: ${find_links}" >&2
[ "${UV_NO_INDEX:-0}" = "1" ] && echo "  no-index: true" >&2
[ -n "${UV_EXTRA_INDEX_URL:-}" ] && echo "  extra-index: ${UV_EXTRA_INDEX_URL}" >&2

venv="${layer}/venv"
[ -x "${venv}/bin/python" ] || uv venv --relocatable --python "${py_bin}/python3" "${venv}" >&2
# uv venv 默认不装 pip；部分应用运行期会 import pip。
# ensurepip 使用解释器自带的 wheel，完全离线。
"${venv}/bin/python" -m ensurepip --upgrade >&2 || true

cd "${app_dir}"
set -- --python "${venv}/bin/python" --index-url "${index}"
[ -n "${UV_EXTRA_INDEX_URL:-}" ] && set -- "$@" --extra-index-url "${UV_EXTRA_INDEX_URL}"
[ -n "${find_links}" ] && set -- "$@" --find-links "${find_links}"
[ "${UV_NO_INDEX:-0}" = "1" ] && set -- "$@" --no-index

if [ -f requirements.txt ]; then
  uv pip install "$@" -r requirements.txt >&2
elif [ -f pyproject.toml ]; then
  uv pip install "$@" . >&2
fi

[ -d .venv ] || true
printf '%s' "${layer}/venv/bin:${py_bin}" > "${layer}/env/PATH.prepend"
printf '%s' ":" > "${layer}/env/PATH.delim"
# 运行时入口可能直接 source /app/.profile.d 或 layer profile.d
mkdir -p "${layer}/profile.d"
cat > "${layer}/profile.d/000_pip_path.sh" <<PROFILE
export PATH="${layer}/venv/bin:${py_bin}:\${PATH}"
PROFILE
mkdir -p "${app_dir}/.profile.d"
printf 'export PATH="%s/venv/bin:%s:$PATH"\n' "${layer}" "${py_bin}" > "${app_dir}/.profile.d/000_pip_path.sh"
cat > "${layer}.toml" <<TOML
[types]
launch = true
build  = true
cache  = true
TOML
cat > "${layer}.sbom.cdx.json" <<'JSON'
{ "bomFormat": "CycloneDX", "specVersion": "1.5", "components": [] }
JSON

# 启动进程：venv 优先，其次 python
if [ -f app.py ]; then cmd="python app.py"
elif [ -f main.py ]; then cmd="python main.py"
else cmd="python app.py"; fi
cat > "${layers_dir}/launch.toml" <<TOML
[[processes]]
  type = "web"
  command = ["/bin/sh", "-c", "PATH=${layer}/venv/bin:${py_bin}:\$PATH exec ${cmd}"]
  default = true
TOML
echo "  ✅ pip-install complete" >&2
