# 构建期变量（dotenv），由 justfile 传给 bksmartpacker --env-file
# 运行时覆盖：BKS_BUILD_ENV="KEY=VALUE ..." just smart
UV_PYTHON_INSTALL_MIRROR=https://gh-proxy.com/https://github.com/astral-sh/python-build-standalone/releases/download
UV_HTTP_TIMEOUT=600

# 本地 wheels 示例：挂载后按容器内路径填写
# PIP_FIND_LINKS=/cnb-pkgs
# UV_NO_INDEX=1
