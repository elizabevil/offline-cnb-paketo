#!/bin/sh
# build — Node.js buildpack (离线版)
# 通过 fnm 安装 Node.js，执行 npm install / yarn / pnpm
# Args: <layers_dir> <platform_dir> <plan>
# App: CNB_APP_DIR 或当前目录
#
# 遵循 Paketo 约定: BP_NODE_VERSION 指定 Node 版本

set -euo pipefail

layers_dir="${1:?missing layers dir}"
platform_dir="${2:-}"
plan="${3:-}"
app_dir="${CNB_APP_DIR:-$(pwd)}"

# ── BP_* 配置（Paketo 约定） ──────────────────────────────
BP_NODE_VERSION="${BP_NODE_VERSION:-${NODE_VER:-20}}"
CACHE_TOML_SRC="${CACHE_TOML_SRC:-/cnb/layers/cache.toml}"

# ── Node layer ──────────────────────────────────────────────
node_layer="${layers_dir}/node"
mkdir -p "${node_layer}/bin" "${node_layer}/env"

# Layer 元数据: build 和 launch 阶段均可用
cat > "${node_layer}.toml" <<'TOM'
[types]
launch = true
build  = true
cache  = true
TOM

# ── 通过 fnm 安装 Node ────────────────────────────────────────
export FNM_DIR="${FNM_DIR:-${CNB_CACHE_DIR:-/layers/cache}/node}"

if [ ! -f "${FNM_DIR}/aliases/default" ]; then
  echo "  ⬇️  Installing Node.js v${BP_NODE_VERSION} via fnm..."
  fnm install "${BP_NODE_VERSION}" --fnm-dir="${FNM_DIR}" 2>&1 | sed 's/^/     /'
  fnm default "${BP_NODE_VERSION}" --fnm-dir="${FNM_DIR}" 2>/dev/null || true
else
  echo "  ⏭️  Node.js already cached in ${FNM_DIR}"
fi

# 定位已安装的 Node 二进制路径
node_bin_dir="$(fnm exec --fnm-dir="${FNM_DIR}" -- sh -c 'dirname "$(which node)"' 2>/dev/null || true)"
if [ -z "${node_bin_dir}" ]; then
  node_bin_dir="${FNM_DIR}/node-versions/${BP_NODE_VERSION}/installation/bin"
fi

if [ -f "${node_bin_dir}/node" ]; then
  # 启动层必须自包含：cache 不会进入产物镜像，直接软链会导致 npm 悬空
  mkdir -p "${node_layer}/nodejs"
  cp -a "${node_bin_dir}/../." "${node_layer}/nodejs/"
  ln -sf ../nodejs/bin/node "${node_layer}/bin/node"
  ln -sf ../nodejs/bin/npm  "${node_layer}/bin/npm"
  ln -sf ../nodejs/bin/npx  "${node_layer}/bin/npx"
else
  echo "  ❌ Node binary not found at ${node_bin_dir}"
  exit 1
fi

# 导出 PATH 供后续步骤使用
echo "${node_layer}/bin" > "${node_layer}/env/PATH.prepend"
export PATH="${node_layer}/bin:${PATH}"

# ── npm/yarn 缓存层 ────────────────────────────────────────────
cache_layer="${CNB_CACHE_DIR:-/layers/cache}/npm-cache"
mkdir -p "${cache_layer}/cache"
cat > "${cache_layer}.toml" <<'TOM'
[types]
launch = false
build  = true
cache  = true
TOM

export npm_config_cache="${cache_layer}/cache"

# ── 安装项目依赖 ────────────────────────────────────────────────
cd "${app_dir}"

if [ -f "pnpm-lock.yaml" ]; then
  echo "  📦  pnpm install (pnpm-lock.yaml)"
  pnpm install --prefer-offline 2>&1 | sed 's/^/     /'
elif [ -f "yarn.lock" ]; then
  echo "  📦  yarn install --frozen-lockfile"
  yarn install --frozen-lockfile 2>&1 | sed 's/^/     /'
elif [ -f "package-lock.json" ]; then
  echo "  📦  npm ci (package-lock.json)"
  npm ci --prefer-offline 2>&1 | sed 's/^/     /'
else
  echo "  📦  npm install"
  npm install 2>&1 | sed 's/^/     /'
fi

# ── 默认启动命令 ──────────────────────────────────────────────────
if [ -f "package.json" ] && jq -e '.scripts.start' package.json >/dev/null 2>&1; then
  cat > "${layers_dir}/launch.toml" <<'TOM'
[[processes]]
  type = "web"
  command = ["/bin/sh", "-c", "PATH=${node_layer}/bin:$PATH npm start"]
  default = true
TOM
fi

echo "  ✅  Node.js build complete"
exit 0
