#!/bin/sh
# build — Python buildpack (离线版)
# 通过 uv 创建 venv，安装项目依赖
# Args: <layers_dir> <platform_dir> <plan>
# App: CNB_APP_DIR 或当前目录
#
# 遵循 Paketo 约定: BP_PYTHON_VERSION 指定 Python 版本

set -euo pipefail

# ── 预置文件路径（Dockerfile COPY 进镜像） ─────────────────
CACHE_TOML_SRC="/cnb/layers/cache.toml"

layers_dir="${1:?missing layers dir}"
platform_dir="${2:-}"
plan="${3:-}"
app_dir="${CNB_APP_DIR:-$(pwd)}"

# ── BP_* 配置（Paketo 约定） ──────────────────────────────
BP_PYTHON_VERSION="${BP_PYTHON_VERSION:-${PYTHON_VER:-3.12}}"

# ── Python layer ────────────────────────────────────────────
python_layer="${layers_dir}/python"
mkdir -p "${python_layer}/bin" "${python_layer}/env"

cat > "${python_layer}.toml" <<'TOM'
[types]
launch = true
build  = true
cache  = true
TOM

# ── 通过 uv 创建 venv ──────────────────────────────────────────
export UV_CACHE_DIR="${UV_CACHE_DIR:-${CNB_CACHE_DIR:-/layers/cache}/python}"
venv_dir="${python_layer}/venv"

if [ ! -f "${venv_dir}/bin/python" ]; then
  echo "  🐍  Creating Python ${BP_PYTHON_VERSION} venv via uv..."
  uv venv --python "${BP_PYTHON_VERSION}" "${venv_dir}" 2>&1 | sed 's/^/     /'
else
  echo "  ⏭️  venv already exists at ${venv_dir}"
fi

# 创建 symlink 到 layer bin
ln -sf "${venv_dir}/bin/python" "${python_layer}/bin/python"
ln -sf "${venv_dir}/bin/pip"    "${python_layer}/bin/pip"

# 导出 PATH
echo "${python_layer}/bin" > "${python_layer}/env/PATH.prepend"
echo "${venv_dir}/bin"    >> "${python_layer}/env/PATH.prepend"

export PATH="${venv_dir}/bin:${python_layer}/bin:${PATH}"

# ── pip 缓存层 ──────────────────────────────────────────────────
pip_layer="${CNB_CACHE_DIR:-/layers/cache}/pip-cache"
mkdir -p "${pip_layer}/cache"
cat > "${pip_layer}.toml" <<'TOM'
[types]
launch = false
build  = true
cache  = true
TOM

export PIP_CACHE_DIR="${pip_layer}/cache"

# ── 安装项目依赖 ──────────────────────────────────────────────────
cd "${app_dir}"

if [ -f "requirements.txt" ]; then
  echo "  📦  pip install -r requirements.txt"
  uv pip install -r requirements.txt 2>&1 | sed 's/^/     /'
elif [ -f "setup.py" ] || [ -f "setup.cfg" ]; then
  echo "  📦  pip install -e . (setup.py/setup.cfg)"
  uv pip install -e . 2>&1 | sed 's/^/     /'
elif [ -f "pyproject.toml" ]; then
  echo "  📦  pip install -e . (pyproject.toml)"
  uv pip install -e . 2>&1 | sed 's/^/     /'
elif [ -f "Pipfile" ]; then
  echo "  📦  pip install Pipfile (pipenv)"
  uv pip install -r <(pipenv requirements 2>/dev/null || echo "") 2>&1 | sed 's/^/     /'
fi

# ── 默认启动命令 ──────────────────────────────────────────────────
cat > "${layers_dir}/launch.toml" <<'TOM'
[[processes]]
  type = "web"
  command = ["/bin/sh", "-c", "PATH=${python_layer}/bin:${venv_dir}/bin:$PATH python app.py"]
  default = true

[[processes]]
  type = "web"
  command = ["/bin/sh", "-c", "PATH=${python_layer}/bin:${venv_dir}/bin:$PATH python main.py"]

[[processes]]
  type = "web"
  command = ["/bin/sh", "-c", "PATH=${python_layer}/bin:${venv_dir}/bin:$PATH gunicorn app:app"]
TOM

echo "  ✅  Python build complete"
exit 0
