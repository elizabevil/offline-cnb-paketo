#!/bin/sh
# detect — Go buildpack (offline)
# Detects Go projects by the presence of go.mod.
# Args: <platform_dir> <plan_path>  (CNB 规范)
# App: CNB_APP_DIR or CWD

# ── Color helpers ────────────────────────────────────────────
green='\033[0;32m'
yellow='\033[1;33m'
red='\033[0;31m'
nc='\033[0m'

set -euo pipefail

platform_dir="${1:-${CNB_PLATFORM_DIR:-/platform}}"
plan_path="${2:-${CNB_PLAN_PATH:-}}"
app_dir="${CNB_APP_DIR:-$(pwd)}"

if [ -f "${app_dir}/go.mod" ]; then
  printf "  ${green}✅${nc}  go.mod\n"
  printf "  ${yellow}🟦${nc}  Go project detected\n"
  exit 0
fi

printf "  ${red}❌${nc}  no go.mod found\n"
exit 1
