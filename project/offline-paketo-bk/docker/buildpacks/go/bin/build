#!/bin/sh
# build — Go buildpack (offline)
# Args: <layers_dir> <platform_dir> <plan>
# App: CNB_APP_DIR or CWD

# ── Color helpers（ANSI 转义码） ────────────────────────────
info()  { printf "  \033[0;34mℹ️\033[0m  %s\033[0m\n" "$*"; }
ok()    { printf "  \033[0;32m✅\033[0m  %s\033[0m\n" "$*"; }
warn()  { printf "  \033[1;33m⏭️\033[0m  %s\033[0m\n" "$*"; }
err()   { printf "  \033[0;31m❌\033[0m  %s\033[0m\n" "$*" >&2; }
step()  { printf "\n  \033[0;36m━━━\033[0m  \033[1m%s\033[0m  \033[0;36m━━━\033[0m\n" "$*"; }
detail(){ printf "  \033[2m%s\033[0m\n" "$*"; }

# ── Go 下载 URL 构造 ─────────────────────────────────────────
# 固定格式: go<version>.linux-<arch>.tar.gz
go_download_url() {
  local ver="${1:?missing version}"
  local arch="${2:?missing arch}"
  printf 'https://mirrors.aliyun.com/golang/go%s.linux-%s.tar.gz' "${ver}" "${arch}"
}

set -euo pipefail

layers_dir="${1:?missing layers dir}"
platform_dir="${2:-}"
plan="${3:-}"
app_dir="${CNB_APP_DIR:-$(pwd)}"

step "Go Buildpack"
detail "app:    ${app_dir}"
detail "layers: ${layers_dir}"

# ── 构建参数配置（混合模式） ────────────────────────────────
# 优先级：环境变量 > .go-buildpack 配置文件 > 脚本默认值

# 加载项目配置文件 .go-buildpack（如果存在）
build_config="${app_dir}/.go-buildpack"
if [ -f "${build_config}" ]; then
  info "loading build config from ${build_config}"
  while IFS='=' read -r key value; do
    case "${key}" in \#*|"") continue ;; esac
    key=$(printf '%s' "${key}" | xargs)
    value=$(printf '%s' "${value}" | xargs)
    # 仅在环境变量未设置时应用配置文件的值
    eval "current=\${${key}:-}"
    if [ -z "${current}" ]; then
      eval "${key}=\"${value}\""
    fi
  done < "${build_config}"
fi

# 应用默认值（仅在变量仍未设置时）
: "${GO_LDFLAGS:=-s -w}"
: "${GO_TAGS:=}"
: "${GO_TRIMPATH:=true}"
: "${GO_GCFLAGS:=}"
: "${GO_ASMFLAGS:=}"
: "${GO_RACE:=false}"
: "${GO_MOD:=}"

# 显示最终生效的构建参数
detail "ldflags:  ${GO_LDFLAGS:-<none>}"
detail "tags:     ${GO_TAGS:-<none>}"
detail "trimpath: ${GO_TRIMPATH}"
detail "race:     ${GO_RACE}"
[ -n "${GO_GCFLAGS}" ]  && detail "gcflags:  ${GO_GCFLAGS}"
[ -n "${GO_ASMFLAGS}" ] && detail "asmflags: ${GO_ASMFLAGS}"
[ -n "${GO_MOD}" ]      && detail "mod:      ${GO_MOD}"
# Go 环境变量（从容器环境读取）
[ -n "${CGO_ENABLED:-}" ] && detail "CGO_ENABLED: ${CGO_ENABLED}"
[ -n "${GOARCH:-}" ]      && detail "GOARCH:      ${GOARCH}"
[ -n "${GOOS:-}" ]        && detail "GOOS:        ${GOOS}"

# 显式导出 Go 环境变量（确保 go build 能读取）
[ -n "${CGO_ENABLED:-}" ] && export CGO_ENABLED
[ -n "${GOARCH:-}" ]      && export GOARCH
[ -n "${GOOS:-}" ]        && export GOOS

# 验证 Go 环境变量
if command -v go >/dev/null 2>&1; then
  detail "go env CGO_ENABLED=$(go env CGO_ENABLED 2>/dev/null || echo '<not set>')"
  detail "go env GOARCH=$(go env GOARCH 2>/dev/null || echo '<not set>')"
  detail "go env GOOS=$(go env GOOS 2>/dev/null || echo '<not set>')"
fi

# ── Go 版本检测 ────────────────────────────────────────────────
GO_VERSION_OVERRIDE="${GO_VERSION:-}"             # 外部覆盖版本号
#GO_SDK_INDEX_URL="${GO_SDK_INDEX_URL:-https://mirrors.aliyun.com/golang/}"
GO_SDK_INDEX_URL="${GO_SDK_INDEX_URL:-http://192.168.11.4:5000/}"
GO_DOWNLOAD_URL="${GO_DOWNLOAD_URL:-}"

if [ -n "${GO_VERSION_OVERRIDE}" ]; then
  requested_version="${GO_VERSION_OVERRIDE}"
  info "GO_VERSION override: ${requested_version}"
else
  if [ ! -f "${app_dir}/go.mod" ]; then
    err "no go.mod found"
    exit 1
  fi

  go_version_line=$(grep '^go ' "${app_dir}/go.mod" | head -n1 || true)
  if [ -z "${go_version_line}" ]; then
    err "failed to detect Go version from go.mod"
    exit 1
  fi

  requested_version=$(printf '%s' "${go_version_line}" | awk '{print $2}')
  if [ -z "${requested_version}" ]; then
    err "invalid Go version line: ${go_version_line}"
    exit 1
  fi
fi

# 校验版本号格式
if ! printf '%s' "${requested_version}" | grep -Eq '^[0-9]+\.[0-9]+(\.[0-9]+)?$'; then
  err "invalid Go version: ${requested_version}"
  exit 1
fi

# ── 架构映射 ──────────────────────────────────────────────────────
uname_arch=$(uname -m)
case "${uname_arch}" in
  x86_64)          go_arch="amd64" ;;
  aarch64|arm64)   go_arch="arm64" ;;
  *)
    err "unsupported architecture: ${uname_arch}"
    exit 1
    ;;
esac
detail "arch:   ${go_arch}"

# 若只指定了 major.minor（如 "1.22"），则从镜像源解析最新补丁版本
major_minor=$(printf '%s' "${requested_version}" | awk -F'.' '{print $1 "." $2}')
if printf '%s' "${requested_version}" | grep -Eq '^[0-9]+\.[0-9]+$'; then
  info "resolving latest patch for Go ${major_minor} from ${GO_SDK_INDEX_URL}"
  latest_version=$(curl -fsSL "${GO_SDK_INDEX_URL}" 2>/dev/null \
    | grep -oE "go${major_minor}\.[0-9]+\.linux-${go_arch}\.tar\.gz" \
    | sort -V | uniq | tail -n1 \
    | sed -E 's/^go(.*)\.linux-.*$/\1/')
  if [ -z "${latest_version}" ]; then
    err "could not resolve latest Go patch version for ${major_minor} from ${GO_SDK_INDEX_URL}"
    exit 1
  fi
  go_full_version="${latest_version}"
else
  go_full_version="${requested_version}"
fi

# ── 离线缓存目录 ────────────────────────────────────────────────
step "Go SDK ${go_full_version}"
# 缓存根：只挂载这一个目录即可（e2e 挂到 /layers/cache）
cache_root="${CNB_CACHE_DIR:-/layers/cache}"
cache_dir="${cache_root}/go"
download_dir="${cache_dir}/download"   # 下载的 SDK 压缩包
sdk_root="${cache_dir}/sdk"            # 解压后的 SDK
go_sdk_dir="${sdk_root}/go${go_full_version}"
go_archive="${download_dir}/go${go_full_version}.linux-${go_arch}.tar.gz"
if [ -z "${GO_DOWNLOAD_URL}" ]; then
  GO_DOWNLOAD_URL=$(go_download_url "${go_full_version}" "${go_arch}")
fi

mkdir -p "${download_dir}" "${go_sdk_dir}" "${cache_dir}/mod" "${cache_dir}/build"

# ── 提取或下载 Go SDK ──────────────────────────────────────────────
if [ -x "${go_sdk_dir}/bin/go" ]; then
  ok "Go SDK cache hit: ${go_full_version} (from ${go_sdk_dir})"
else
  if [ -f "${go_archive}" ]; then
    info "Extracting cached Go SDK from ${go_archive}"
    mkdir -p "${go_sdk_dir}"
    tar -xzf "${go_archive}" -C "${go_sdk_dir}" --strip-components=1
  else
    info "Downloading Go SDK ${go_full_version} from ${GO_DOWNLOAD_URL}"
    curl -fsSL --retry 3 --retry-delay 2 \
      -o "${go_archive}" "${GO_DOWNLOAD_URL}"
    mkdir -p "${go_sdk_dir}"
    tar -xzf "${go_archive}" -C "${go_sdk_dir}" --strip-components=1
  fi
fi

if [ ! -x "${go_sdk_dir}/bin/go" ]; then
  err "Go SDK installation failed"
  exit 1
fi

export PATH="${go_sdk_dir}/bin:${PATH}"

# ── Go 模块缓存 ────────────────────────────────────────────────
export GOMODCACHE="${cache_dir}/mod"      # 依赖模块
export GOCACHE="${cache_dir}/build"    # 构建缓存
mkdir -p "${GOMODCACHE}" "${GOCACHE}"

# ── Build layer ─────────────────────────────────────────────────
go_layer="${layers_dir}/go"
mkdir -p "${go_layer}/bin" "${go_layer}/env"
cat > "${go_layer}.toml" <<'TOM'
[types]
launch = true
build  = true
cache  = true
TOM

# ── Ensure Go module dependencies are downloaded and built ────────
cd "${app_dir}"

info "detected Go module version ${requested_version} → ${go_full_version}"

main_dir=$(go list -f '{{if eq .Name "main"}}{{.Dir}}{{end}}' ./... 2>/dev/null | grep -v '^$' | head -n1 || true)
if [ -z "${main_dir}" ]; then
  err "no main package found in module"
  exit 1
fi

cd "${main_dir}"

step "Building Go binary"
detail "main package: ${main_dir}"
detail "output:       ${go_layer}/bin/app"

# 构建 go build 参数
go_build_cmd="go build -o '${go_layer}/bin/app'"
[ "${GO_TRIMPATH}" = "true" ] && go_build_cmd="${go_build_cmd} -trimpath"
[ "${GO_RACE}" = "true" ] && go_build_cmd="${go_build_cmd} -race"
[ -n "${GO_LDFLAGS}" ] && go_build_cmd="${go_build_cmd} -ldflags '${GO_LDFLAGS}'"
[ -n "${GO_TAGS}" ] && go_build_cmd="${go_build_cmd} -tags '${GO_TAGS}'"
[ -n "${GO_GCFLAGS}" ] && go_build_cmd="${go_build_cmd} -gcflags '${GO_GCFLAGS}'"
[ -n "${GO_ASMFLAGS}" ] && go_build_cmd="${go_build_cmd} -asmflags '${GO_ASMFLAGS}'"
[ -n "${GO_MOD}" ] && go_build_cmd="${go_build_cmd} -mod '${GO_MOD}'"
go_build_cmd="${go_build_cmd} ."

info "command: ${go_build_cmd}"
eval "${go_build_cmd}" 2>&1 | while IFS= read -r line; do
  printf "  \033[2m> \033[0m%s\n" "${line}"
done

# ── Export PATH for downstream build and launch
printf '%s\n' "${go_layer}/bin" > "${go_layer}/env/PATH.prepend"
export PATH="${go_layer}/bin:${PATH}"

# ── Launch process
cat > "${layers_dir}/launch.toml" <<TOM
[[processes]]
  type = "web"
  # go buildpack 的 api = 0.12：processes.command 必须是数组
  # （api <= 0.8 的 node/python 则要求字符串，两者不能统一）
  command = ["${go_layer}/bin/app"]
  default = true
TOM

ok "Go build complete"
exit 0
