# ─── offline-paketo-bk 子项目入口 ─────────────────────────────────────────────────────
# 流程定义在 config/projects/offline-paketo-bk.toml：物料、版本、镜像、顺序、打包。
# 这里只做入口转发；改流程请改配置，不要改这里。

set dotenv-load := true

_dir := justfile_directory()
_profile := _dir / ".." / ".." / "config" / "projects" / "offline-paketo-bk.toml"

_default:
    @just --list

# 按流水线配置执行（物料 → 镜像 → 打包）
build *args:
    @{{_dir}}/../../script/bin/cnb pipeline run {{_profile}} {{args}}

# 只打印执行计划与命令，不真正构建
plan:
    @{{_dir}}/../../script/bin/cnb pipeline run {{_profile}} --dry-run

# ── 物料（委托仓库根基座）──────────────────────────────────────────────────

# 下载 + 解压（版本与地址来自 assets.lock.toml）
fetch *ids:
    @just --justfile {{_dir}}/../../justfile fetch {{ids}}

# 校验本流程物料（范围与规则来自配置）
verify:
    @{{_dir}}/../../script/bin/cnb pipeline profile verify {{_profile}}

# 夹具构建与打包（BK 结构）
fixtures *args:
    @just --justfile {{_dir}}/fixtures/justfile {{args}}

# ── bksmartpacker 全链路（一条命令）────────────────────────────────────────

_root := _dir / ".." / ".."
_bps  := _root / "script/tools/bksmartpacker_v3/bin/bksmartpacker-linux"
_fx   := _dir / "fixtures/single"
_out  := "/tmp/bk-paketo-smart"
smart_builder := env_var_or_default("BUILDER_IMAGE", "offline-builder-build-bk:latest")
# 运行时（Go/Node/Python SDK）禁止打进镜像，只能在这里挂载：
#   CNB_RUNTIMES=/opt/cnb-runtimes just smart
# 宿主机目录需按 <lang>/<version>/... 组织，容器内挂到 /cnb/runtimes
runtimes := env_var_or_default("CNB_RUNTIMES", "")
# 跨构建缓存：宿主目录挂到 /layers/cache，首次下载、后续命中
cache_dir := env_var_or_default("CNB_CACHE_DIR", _root / ".cache/bk-cache")
# 容器网络：host 可直接访问宿主机内网（如 192.168.11.4 镜像源）
network := env_var_or_default("CNB_NETWORK", "host")
# 容器运行时 socket：podman 用户态 socket（不存在则用默认 docker.sock）
podman_sock := env_var_or_default("XDG_RUNTIME_DIR", "/run/user/1000") / "podman/podman.sock"
docker_sock := env_var_or_default("CNB_DOCKER_SOCK", podman_sock)
runtimes_mount := if runtimes != "" { "--mount type=bind,source=" + runtimes + ",target=/cnb/runtimes,readonly " } else { "" }
cache_mount := "--mount type=bind,source=" + cache_dir + ",target=/layers/cache"
mounts := runtimes_mount + cache_mount

# 构建三个镜像（跳过打包阶段）
smart-builder *args:
    @{{_root}}/script/bin/cnb pipeline run {{_profile}} --no-commands {{args}}

# 编译 bksmartpacker（源码不入库，需本地存在）
smart-bps:
    # 清掉可能残留的 GOROOT/GOPATH（如上一次在容器内使用过的路径），
    # 否则 make 会拿容器路径去编宿主二进制
    @cd {{_root}}/script/tools/bksmartpacker_v3 && \
      env -u GOROOT -u GOPATH make build-cli
    @echo "  ✓ {{_bps}}"

# 全链路：构建镜像 → 编译工具 → 打包夹具 → 校验产物
smart: smart-builder smart-bps
    @if [ -n "{{runtimes}}" ] && [ ! -d "{{runtimes}}" ]; then \
        echo "  ✗ CNB_RUNTIMES 指向的目录不存在: {{runtimes}}"; exit 1; fi
    @mkdir -p {{cache_dir}} {{_out}}
    @echo "  · 输出: {{_out}}/s-mart.tgz"
    @rm -f {{_out}}/s-mart.tgz
    @test -x {{_bps}} || { echo "  ✗ 缺少 bksmartpacker"; exit 1; }
    @BKS_CONTAINER_CLI=podman BKS_NETWORK="{{network}}" BKS_DOCKER_SOCK="{{docker_sock}}" BKS_EXTRA_MOUNTS="{{mounts}}" {{_bps}} --src {{_fx}} \
        --builder-image "{{smart_builder}}" \
        --dest {{_out}}/s-mart.tgz
    @echo
    @echo "== 产物路径 ==" && ls -lh {{_out}}/s-mart.tgz
    @echo "== 缓存目录 ==" && du -sh {{cache_dir}} 2>/dev/null || true
    @echo "== 产物内容 =="
    @tar -tzf {{_out}}/s-mart.tgz | sed 's/^/  /'
    @echo "== .Version =="
    @tar -xzOf {{_out}}/s-mart.tgz .Version 2>/dev/null | sed 's/^/  /' || echo "  ✗ 缺少 .Version"
    @echo
    @echo "== 层包（应只含应用层）=="
    @tmp="$(mktemp -d)"; tar -xzf {{_out}}/s-mart.tgz -C "$tmp"; \
      found=0; for f in "$tmp"/*.tgz "$tmp"/layers/*.tgz; do \
        [ -f "$f" ] || continue; found=1; \
        echo "  $(basename "$f")"; tar -tf "$f" | head -6 | sed 's/^/    /'; \
      done; \
      [ "$found" = 1 ] || echo "  ✗ 包内没有层 tgz"; \
      rm -rf "$tmp"

# 清理打包产物
smart-clean:
    @rm -rf {{_out}}
    @echo "  ✓ 已清理 {{_out}}"
