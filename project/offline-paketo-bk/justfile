# ─── offline-paketo-bk 子项目入口 ─────────────────────────────────────────────────────
# 流程定义在 project/offline-paketo-bk/pipeline.toml：物料、版本、镜像、顺序、打包。
# 这里只做入口转发；改流程请改配置，不要改这里。

_dir := justfile_directory()
_root := _dir / ".." / ".."
_cnb := env_var_or_default("CNB_BIN", _root / "script" / "bin" / "cnb-linux-amd64")
# 被测流水线配置：默认本项目；CNB_PROFILE 可指向任意项目
#   CNB_PROFILE=project/other/pipeline.toml just smart   （相对仓库根）
#   CNB_PROFILE=/abs/path/other.toml just smart        （绝对路径）
_profile_env := env_var_or_default("CNB_PROFILE", "")
# 物料清单：仓库级 project/assets.toml（脚手架生成的项目会改写为本地 assets.toml）
_manifest := env_var_or_default("CNB_ASSETS", _dir / ".." / "assets.toml")
_profile := if _profile_env == "" { _root / "project" / "offline-paketo-bk" / "pipeline.toml" } else if _profile_env =~ '^/' { _profile_env } else { _root / _profile_env }

_default:
    @just --list

# 按流水线配置执行（物料 → 镜像 → 打包）
build *args:
    @{{_cnb}} pipeline run {{_profile}} {{args}}

# 只打印执行计划（yaml；--full 展开完整计划）
plan *args:
    @{{_cnb}} pipeline plan {{_profile}} {{args}}

# ── 物料（委托仓库根基座）──────────────────────────────────────────────────

# 下载 + 校验 + 解包（地址与规则来自 assets.lock.toml，位置由 [bundle].path 决定）
fetch *ids:
    @{{_cnb}} materials sync {{ids}}

# 校验物料落盘状态 + 配置合法性
verify:
    @{{_cnb}} materials verify
    @{{_cnb}} pipeline profile validate {{_profile}}

# 夹具构建与打包（BK 结构）
fixtures *args:
    @just --justfile {{_dir}}/fixtures/justfile {{args}}

# ── bksmartpacker 全链路（一条命令）────────────────────────────────────────

# 宿主工具统一放 script/bin/（与 cnb 同目录，构建产物不入库）
_bps  := env_var_or_default("BPS_BIN", _root / "script" / "bin" / "bksmartpacker-linux-amd64")
# 夹具目录：默认 fixtures/single，可用 S_MART_SRC 指向其它夹具（如 fixtures/multi）
_fx   := env_var_or_default("S_MART_SRC", _dir / "fixtures/single")
# 目标平台：优先 BKS_PLATFORM（linux/arm64），否则按宿主架构
_host_platform := "linux-" + (if arch() == "aarch64" { "arm64" } else { "amd64" })
_bks_platform  := env_var_or_default("BKS_PLATFORM", "")
_platform      := if _bks_platform != "" { replace(_bks_platform, "/", "-") } else { _host_platform }
_out  := env_var_or_default("S_MART_OUT", _dir / "dist" / _platform)
# 下载代理：优先 CNB_DOWNLOAD_PROXY，其次标准 HTTPS_PROXY/HTTP_PROXY
_download_proxy := env_var_or_default("CNB_DOWNLOAD_PROXY", env_var_or_default("HTTPS_PROXY", env_var_or_default("https_proxy", env_var_or_default("HTTP_PROXY", env_var_or_default("http_proxy", "")))))
_download_proxy_env := if _download_proxy != "" { "http_proxy=" + _download_proxy + " https_proxy=" + _download_proxy + " " } else { "" }
_target_arch := if _platform == "linux-arm64" { "arm64" } else { "amd64" }
_runtime_base := if _platform == "linux-arm64" { "swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/debian:trixie-slim-linuxarm64" } else { "swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/debian:trixie-slim" }
_platform_flag := " --platform " + _platform
smart_builder := env_var_or_default("BUILDER_IMAGE", "offline-builder-build-bk:" + _target_arch)
# 运行时（Go/Node/Python SDK）禁止打进镜像，只能在这里挂载：
#   CNB_RUNTIMES=/opt/cnb-runtimes just smart
# 宿主机目录需按 <lang>/<version>/... 组织，容器内挂到 /cnb/runtimes
runtimes := env_var_or_default("CNB_RUNTIMES", "")
# 跨构建缓存：宿主目录挂到 /layers/cache，首次下载、后续命中
cache_dir := env_var_or_default("CNB_CACHE_DIR", _root / ".cache/bk-cache")
# 容器网络：host 可直接访问宿主机内网（如 192.168.11.4 镜像源）
network := env_var_or_default("CNB_NETWORK", "host")
# 容器运行时 socket：podman 用户态 socket（不存在则用默认 docker.sock）
podman_sock := env_var_or_default("XDG_RUNTIME_DIR", "/run/user/1000") / "podman/podman.sock"
docker_sock := env_var_or_default("CNB_DOCKER_SOCK", podman_sock)
runtimes_mount := if runtimes != "" { "--mount type=bind,source=" + runtimes + ",target=/cnb/runtimes,readonly " } else { "" }
cache_mount := "--mount type=bind,source=" + cache_dir + ",target=/layers/cache"
mounts := runtimes_mount + cache_mount
# 注入构建容器的变量（与源码无关；BKS_BUILD_ENV 空格分隔 KEY=VALUE）
# 默认给 Python 走 gh-proxy 的运行时镜像；需要时用环境变量覆盖
bp_env := env_var_or_default("BKS_BUILD_ENV", "")
env_file := _dir / "build.env"
env_file_flag := " --env-file " + env_file
bp_modules := env_var_or_default("BKS_MODULES", "")
env_flags := if bp_env != "" { " --env " + replace(bp_env, " ", " --env ") } else { "" }
module_flags := if bp_modules != "" { " --module " + replace(bp_modules, " ", " --module ") } else { "" }

# 构建 builder 镜像（跳过打包阶段）
smart-builder *args:
    @{{_cnb}} pipeline run {{_profile}} --until builder {{_platform_flag}} {{args}}

# 构建 builder，并从 bundle 加载 runtime-pind
smart-runtime *args:
    @{{_cnb}} pipeline run {{_profile}} --until runtime-pind {{_platform_flag}} {{args}}

# 构建 builder，并从 bundle 加载 runtime-pind + runtime-dind
smart-runtime-dind *args:
    @{{_cnb}} pipeline run {{_profile}} --until runtime-dind {{_platform_flag}} {{args}}

# 下载并校验静态 podman bundle（生产者步骤）
podman-static:
    @mkdir -p {{_root}}/bundle/{{_platform}}/binaries/podman-static/6.2.1
    @test -f {{_root}}/bundle/{{_platform}}/binaries/podman-static/6.2.1/podman-linux-{{_target_arch}}.tar.gz || \
        {{_download_proxy_env}}curl -fL --retry 2 -o {{_root}}/bundle/{{_platform}}/binaries/podman-static/6.2.1/podman-linux-{{_target_arch}}.tar.gz \
        https://github.com/mgoltzsche/podman-static/releases/download/v6.2.1/podman-linux-{{_target_arch}}.tar.gz
    @test -f {{_root}}/bundle/{{_platform}}/binaries/podman-static/6.2.1/podman-linux-{{_target_arch}}.tar.gz.sha256 || \
        (cd {{_root}}/bundle/{{_platform}}/binaries/podman-static/6.2.1 && sha256sum podman-linux-{{_target_arch}}.tar.gz > podman-linux-{{_target_arch}}.tar.gz.sha256)
    @(cd {{_root}}/bundle/{{_platform}}/binaries/podman-static/6.2.1 && sha256sum -c {{_dir}}/docker/podman-static-{{_target_arch}}.sha256 2>/dev/null || sha256sum -c {{_dir}}/docker/podman-static.sha256)

# 产出 runtime-dind 离线镜像 tar（生产者步骤，复用 docker 物料）
runtime-dind-bundle:
    @test -f {{_root}}/bundle/{{_platform}}/binaries/docker/27.0.3/docker/dockerd || \
        { echo "  ✗ 缺少 docker 物料：请先 cnb materials sync docker"; exit 1; }
    @mkdir -p {{_root}}/bundle/{{_platform}}/images
    @podman build --platform linux/{{_target_arch}} -f {{_root}}/project/offline-paketo/docker/runtime/runtime-dind.dockerfile \
        --build-arg BASE_IMAGE_TAG={{_runtime_base}} \
        --build-arg BUNDLE_ARCH={{_platform}} \
        --build-arg DOCKER_VERSION=27.0.3 \
        --build-context bundle={{_root}}/bundle \
        --build-context runtime={{_root}}/project/offline-paketo/docker/runtime \
        -t offline-runtime-dind-bk:{{_target_arch}} {{_dir}}
    @podman save --format oci-archive \
        -o {{_root}}/bundle/{{_platform}}/images/runtime-dind.tar \
        offline-runtime-dind-bk:{{_target_arch}}
    @sha256sum {{_root}}/bundle/{{_platform}}/images/runtime-dind.tar > \
        {{_root}}/bundle/{{_platform}}/images/runtime-dind.tar.sha256

# 产出 runtime-pind 离线镜像 tar（生产者步骤，需要静态 podman bundle）
runtime-pind-bundle:
    @test -f {{_root}}/bundle/{{_platform}}/binaries/podman-static/6.2.1/podman-linux-{{_target_arch}}.tar.gz || \
        { echo "  ✗ 缺少静态 podman bundle，请先放入 bundle/{{_platform}}/binaries/podman-static/6.2.1/"; exit 1; }
    @(cd {{_root}}/bundle/{{_platform}}/binaries/podman-static/6.2.1 && sha256sum -c podman-linux-{{_target_arch}}.tar.gz.sha256)
    @mkdir -p {{_root}}/bundle/{{_platform}}/images
    @podman build --platform linux/{{_target_arch}} -f {{_root}}/project/offline-paketo/docker/runtime/runtime-pind.dockerfile \
        --build-arg BASE_IMAGE_TAG={{_runtime_base}} \
        --build-arg BUNDLE_ARCH={{_platform}} \
        --build-arg PODMAN_STATIC_VERSION=6.2.1 \
        --build-arg PODMAN_STATIC_ARCH={{_target_arch}} \
        --build-context bundle={{_root}}/bundle \
        --build-context runtime={{_root}}/project/offline-paketo/docker/runtime \
        -t offline-runtime-pind-bk:{{_target_arch}} {{_dir}}
    @podman save --format oci-archive \
        -o {{_root}}/bundle/{{_platform}}/images/runtime-pind.tar \
        offline-runtime-pind-bk:{{_target_arch}}
    @sha256sum {{_root}}/bundle/{{_platform}}/images/runtime-pind.tar > \
        {{_root}}/bundle/{{_platform}}/images/runtime-pind.tar.sha256

# 开发期快速打包验证
test-quick app=_fx platform=_platform:
    @{{_dir}}/tests/quick.sh "{{app}}" "{{platform}}"

# layout / daemon 导出对比
test-export-modes app=_fx platform=_platform:
    @{{_dir}}/tests/export-modes.sh "{{app}}" "{{platform}}"

# runtime 组合矩阵入口
test-runtime-matrix app=_fx platform=_platform:
    @{{_dir}}/tests/matrix.sh "{{app}}" "{{platform}}"

# 编译 bksmartpacker（转发到工具自己的 justfile，避免重复 go build）
smart-bps:
    @just --justfile {{_root}}/script/tools/bksmartpacker_v3/justfile build
    @out=$("{{_bps}}" --inspect /dev/null 2>&1 || true); \
      case "$out" in *"unknown flag"*) echo "  ⚠ 该二进制不含 --inspect，请确认源码已加";; esac

# 全链路：构建镜像 → 编译工具 → 打包应用目录 → 校验产物
#   just smart                      使用 S_MART_SRC（默认 fixtures/single）
#   just smart /path/to/app         打包任意应用目录（需含 app_desc.yaml）
smart src="{{_fx}}": smart-builder smart-bps
    @umask 022
    @if [ -n "{{runtimes}}" ] && [ ! -d "{{runtimes}}" ]; then \
        echo "  ✗ CNB_RUNTIMES 指向的目录不存在: {{runtimes}}"; exit 1; fi
    @mkdir -p {{cache_dir}} {{_out}}
    @echo "  · 输出: {{_out}}/s-mart.tar.gz"
    @rm -f {{_out}}/s-mart.tar.gz
    @test -x {{_bps}} || { echo "  ✗ 缺少 bksmartpacker"; exit 1; }
    @BKS_CONTAINER_CLI=podman BKS_NETWORK="{{network}}" BKS_DOCKER_SOCK="{{docker_sock}}" BKS_EXTRA_MOUNTS="{{mounts}}" {{_bps}} --src {{src}} \
        {{env_file_flag}} {{env_flags}} {{module_flags}} \
        --builder-image "{{smart_builder}}" \
        --dest {{_out}}/s-mart.tar.gz
    @echo
    @echo "== 产物路径 ==" && ls -lh {{_out}}/s-mart.tar.gz
    @echo "== 缓存目录 ==" && du -sh {{cache_dir}} 2>/dev/null || true
    @echo "== 包结构 =="
    @{{_bps}} --inspect {{_out}}/s-mart.tar.gz
    @(cd {{_out}} && sha256sum s-mart.tar.gz > s-mart.tar.gz.sha256)
    @echo "== 校验和 ==" && cat {{_out}}/s-mart.tar.gz.sha256

# 只打包指定目录（跳过建镜像，复用已有 builder）：just pack-case /path/to/app
pack-case src:
    @umask 022
    @test -d "{{src}}" || { echo "  ✗ 目录不存在: {{src}}"; exit 1; }
    @mkdir -p {{_out}} {{cache_dir}}
    @rm -f {{_out}}/s-mart.tar.gz
    @BKS_CONTAINER_CLI=podman BKS_NETWORK="{{network}}" BKS_DOCKER_SOCK="{{docker_sock}}" BKS_EXTRA_MOUNTS="{{mounts}}" {{_bps}} --src {{src}} \
        {{env_file_flag}} {{env_flags}} {{module_flags}} \
        --builder-image "{{smart_builder}}" \
        --dest {{_out}}/s-mart.tar.gz
    @{{_bps}} --inspect {{_out}}/s-mart.tar.gz
    @(cd {{_out}} && sha256sum s-mart.tar.gz > s-mart.tar.gz.sha256)

# 清理打包产物
smart-clean:
    @rm -rf {{_out}}
    @echo "  ✓ 已清理 {{_out}}"

# 离线校验：配置 + 物料清单（不依赖 bundle）
check:
    @{{_cnb}} pipeline profile validate {{_profile}}
    @{{_cnb}} materials validate --file {{_manifest}}

# 静态检查：构建参数、脚本、Dockerfile COPY 源（需先 fetch）
lint:
    @{{_cnb}} lint {{_profile}}

# 生成/刷新锁文件
lock *ids:
    @{{_cnb}} materials lock {{ids}} --file {{_manifest}}

# 打印占位符解析值
vars:
    @{{_cnb}} pipeline variables {{_profile}}

# D1 压缩：把相同源码的模块合并为单镜像多 tag，并用硬链接去重
#   just dedup            # 处理 dist/<platform>/s-mart.tar.gz
#   just dedup <pkg>      # 处理指定包
dedup pkg="{{_out}}/s-mart.tar.gz":
    @python3 {{_root}}/script/tools/dedup_smart.py "{{pkg}}" --out "{{_out}}/s-mart-d1.tar.gz"
