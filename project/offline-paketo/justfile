# ─── offline-paketo 子项目入口 ─────────────────────────────────────────────
# 流程定义在 project/offline-paketo/pipeline.toml：物料、版本、镜像、顺序、打包。
# 这里只做入口转发；改流程请改配置，不要改这里。

_dir := justfile_directory()
_root := _dir / ".." / ".."
_cnb := env_var_or_default("CNB_BIN", _root / "script" / "bin" / "cnb-linux-amd64")
# 被测配置：默认本项目；CNB_PROFILE 可指向任意项目（相对仓库根或绝对路径）
_profile_env := env_var_or_default("CNB_PROFILE", "")
# 物料清单：仓库级 project/assets.toml（脚手架生成的项目会改写为本地 assets.toml）
_manifest := env_var_or_default("CNB_ASSETS", _dir / ".." / "assets.toml")
_profile := if _profile_env == "" { _root / "project" / "offline-paketo" / "pipeline.toml" } else if _profile_env =~ '^/' { _profile_env } else { _root / _profile_env }
_host_platform := "linux-" + (if arch() == "aarch64" { "arm64" } else { "amd64" })
_platform := env_var_or_default("PLATFORM", _host_platform)
_fx := _dir / "fixtures" / "go-app"

_default:
    @just --list

# 按流水线配置执行（物料 → 镜像 → 打包）
build *args:
    @{{_cnb}} pipeline run {{_profile}} {{args}}

# 只打印执行计划（yaml；--full 展开完整计划）
plan *args:
    @{{_cnb}} pipeline plan {{_profile}} {{args}}

# 下载 + 校验 + 解包（地址与规则来自 assets.lock.toml，位置由 [bundle].path 决定）
fetch *ids:
    @{{_cnb}} materials sync {{ids}}

# 校验物料落盘状态 + 配置合法性
verify:
    @{{_cnb}} materials verify
    @{{_cnb}} pipeline profile validate {{_profile}}

# 夹具（本目录 fixtures/）：build / test / test-all
fixtures *args:
    @just --justfile {{_dir}}/fixtures/justfile {{args}}

# 对本项目夹具跑 e2e（detect → build → analyze → export）
test *args:
    @just --justfile {{_dir}}/fixtures/justfile test-all {{args}}

# 开发期快速验证：builder + plan 冒烟
test-quick app="" platform="": build
    @BKS_APP="{{app}}" BKS_PLATFORM="{{platform}}" {{_dir}}/tests/quick.sh

# 对任意应用目录跑一次 e2e：just test-case /path/to/app
test-case dir *args:
    @E2E_PROFILE={{_profile}} E2E_SKIP_BUILD=1 {{_root}}/test/e2e/lifecycle.sh {{dir}} "$(basename {{dir}})" {{args}}

# 离线校验：配置 + 物料清单（不依赖 bundle）
check:
    @{{_cnb}} pipeline profile validate {{_profile}}
    @{{_cnb}} materials validate --file {{_manifest}}

# 静态检查：构建参数、脚本、Dockerfile COPY 源（需先 fetch）
lint:
    @{{_cnb}} lint {{_profile}}

# 生成/刷新锁文件
lock *ids:
    @{{_cnb}} materials lock {{ids}} --file {{_manifest}}

# 打印占位符解析值
vars:
    @{{_cnb}} pipeline variables {{_profile}}
