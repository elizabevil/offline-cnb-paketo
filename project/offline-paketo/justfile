# ─── offline-paketo 子项目入口 ─────────────────────────────────────────────────────
# 流程定义在 config/projects/offline-paketo.toml：物料、版本、镜像、顺序、打包。
# 这里只做入口转发；改流程请改配置，不要改这里。

set dotenv-load := true

_dir := justfile_directory()
_profile := _dir / ".." / ".." / "config" / "projects" / "offline-paketo.toml"

_default:
    @just --list

# 按流水线配置执行（物料 → 镜像 → 打包）
build *args:
    @{{_dir}}/../../script/bin/cnb pipeline run {{_profile}} {{args}}

# 只打印执行计划与命令，不真正构建
plan:
    @{{_dir}}/../../script/bin/cnb pipeline run {{_profile}} --dry-run

# ── 物料（委托仓库根基座）──────────────────────────────────────────────────

# 下载 + 解压（版本与地址来自 assets.lock.toml）
fetch *ids:
    @just --justfile {{_dir}}/../../justfile fetch {{ids}}

# 校验本流程物料（范围与规则来自配置）
verify:
    @{{_dir}}/../../script/bin/cnb pipeline profile verify {{_profile}}

# ── 示例（案例目录不入库）──────────────────────────────────────────────────

# 对 go 示例跑 detect → build → analyze → export
test:
    @cd {{_dir}}/../.. && just --justfile {{_dir}}/../../justfile test-e2e-core-all
