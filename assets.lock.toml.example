# =============================================================================
# assets.lock.toml 模板（不会生效，仅作参考）
# -----------------------------------------------------------------------------
# 新增物料：
#   1. 复制一个 [[asset]] 块
#   2. 填 id / version / unpack / platform
#   3. url 用 {version} 占位，架构命名保持字面量
#   4. sha256 先留空，fetch 后执行 `cnb pin <id>` 回填
#   5. just check 会 validate 本文件（模板不能腐烂）
#
# 分区说明：
#   [[asset]]                     身份：id / version / default
#     [asset.info]                元信息（不参与构建）
#     [asset.unpack]              kind / strip / dir / expect
#                                 dir 支持 {version}；expect 相对 dir
#     [asset.platform.<platform>] url / sha256
# =============================================================================

schema = 1

[meta]
name = "your-project"
description = "一句话说明这批物料"
provenance = "local-capture"
captured_at = "2026-11-12"
platforms = ["linux-amd64", "linux-arm64"]

[[asset]]
id = "example-tool"
version = "1.2.3"
default = true

  [asset.info]
  name     = "example-tool"
  homepage = "https://example.com"
  license  = "Apache-2.0"

  [asset.unpack]
  kind   = "tgz"
  strip  = 1
  dir    = "example-tool/{version}"
  expect = ["bin/example-tool"]

  [asset.platform.linux-amd64]
  url    = "https://example.com/tool/v{version}/example-tool-linux-amd64.tgz"
  sha256 = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

  [asset.platform.linux-arm64]
  url    = "https://example.com/tool/v{version}/example-tool-linux-arm64.tgz"
  sha256 = ""

[[asset]]
id = "example-bin"
version = "0.9.0"

  [asset.info]
  name     = "example-bin"
  homepage = "https://example.com"
  license  = "Apache-2.0"

  [asset.unpack]
  kind   = "zip"
  strip  = 0
  dir    = "example-bin/{version}"
  expect = ["example-bin"]

  [asset.platform.linux-amd64]
  url    = "https://example.com/bin/v{version}/bin-linux.zip"
  sha256 = ""

  [asset.platform.linux-arm64]
  url    = "https://example.com/bin/v{version}/bin-arm64.zip"
  sha256 = ""

[[asset]]
id = "example-flat"
version = "2.0.0"

  [asset.info]
  name     = "example-flat"
  homepage = "https://example.com"
  license  = "Apache-2.0"

  [asset.unpack]
  kind   = "tgz"
  strip  = 1
  dir    = "example-flat/{version}"
  expect = ["example-flat"]

  [asset.platform.linux-amd64]
  url    = "https://example.com/flat/v{version}/example-flat-x86_64.tgz"
  sha256 = ""

  [asset.platform.linux-arm64]
  url    = "https://example.com/flat/v{version}/example-flat-aarch64.tgz"
  sha256 = ""
