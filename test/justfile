# ─── test/justfile — 测试入口（被根 justfile import）──────────────────────────
# 约定：
#   fixtures/  自有测试项目（入库，稳定）
#   external/  临时验证项目（不入库，外来代码放这里）


_test := source_directory()
_cnb := _test / ".." / "script" / "bin" / "cnb"
# 被测项目配置：默认 offline-paketo，可用 E2E_PROFILE 覆盖（绝对或相对仓库根）
_profile := env_var_or_default("E2E_PROFILE", _test / ".." / "config" / "projects" / "offline-paketo.toml")
# 被测夹具目录：默认 test/fixtures，可用 E2E_FIXTURES 指向其它目录
_fixtures := env_var_or_default("E2E_FIXTURES", _test / "fixtures")

# just 的 import 之间不共享变量，这里重复一次同样的探测（可用 GO=… 覆盖）

# 构建需要预编译二进制的夹具（源码在 fixtures-src/，产物进 fixtures/）
fixtures:
    @cd {{_test}}/fixtures-src/procfile-app && CGO_ENABLED=0 GOOS=linux "$({{_test}}/../script/lib/go.sh)" build -o {{_test}}/fixtures/procfile-app/app server.go
    @echo "  ✓ procfile-app/app"

# 全部快速测试（单测 + 契约）
test: test-unit test-contract test-scripts

# 脚本语法检查
test-scripts:
    @find {{_test}}/../project/*/tests {{_test}}/../script/tools/cnb/tests -type f -name '*.sh' -print0 2>/dev/null | xargs -0 -r bash -n
    @echo "  ✓ test scripts syntax"

# Go 单测
test-unit:
    @cd {{_test}}/../script/tools/cnb && \
      "$({{_test}}/../script/lib/go.sh)" test ./...

# 全部契约测试
test-contract: test-contract-get test-contract-validate test-contract-plan

# 契约：cnb materials get 输出字段
test-contract-get:
    @{{_test}}/contract/get-contract.sh

# 契约：坏配置必须被拒绝
test-contract-validate:
    @{{_test}}/contract/validate-rejects.sh

# 契约：计划三种格式
test-contract-plan:
    @{{_test}}/contract/plan-formats.sh

# 单个 e2e（fixtures）：just test-e2e go-app
test-e2e name:
    @{{_test}}/e2e/run.sh {{_fixtures}}/{{name}} {{name}}

# 单个 e2e（lifecycle 直连，不走 pack）：just test-e2e-core go-app
test-e2e-core name:
    @{{_test}}/e2e/lifecycle.sh {{_fixtures}}/{{name}} {{name}}

# 全部 lifecycle 直连用例
test-e2e-core-all:
    @{{_cnb}} pipeline run {{_profile}}
    @for d in {{_fixtures}}/*/; do \
      E2E_SKIP_BUILD=1 {{_test}}/e2e/lifecycle.sh "$d" "$(basename "$d")" || exit 1; \
    done

# 全部 e2e（fixtures，需要 pack）：先重建一次 builder，再逐个用例
test-e2e-all:
    @{{_cnb}} pipeline run {{_profile}}
    @{{_cnb}} pipeline doctor {{_profile}} || true
    @for d in {{_fixtures}}/*/; do \
      E2E_SKIP_BUILD=1 {{_test}}/e2e/auto.sh "$d" "$(basename "$d")" || exit 1; \
    done

# 单个 e2e（自动选择路径）
test-e2e-auto name:
    @{{_test}}/e2e/auto.sh {{_fixtures}}/{{name}} {{name}}

# 临时验证项目：just test-external /path/to/app
test-external path:
    @{{_test}}/e2e/run.sh "{{path}}" external
