# 复制为 .env 后按需修改；.env 不进版本库
#
# 代理优先级：命令行 > 环境变量 > 本文件
#   just fetch --proxy http://127.0.0.1:7890
#   PROXY_URL=http://127.0.0.1:7890 just fetch
PROXY_URL=

# 默认目标平台（linux-amd64 | linux-arm64），留空则由宿主机推断
PLATFORM=

# GitHub 发布下载受限时的镜像前缀（末尾带 /）
GH_MIRROR=https://ghfast.top/

# Go SDK 下载源（末尾带 /），也可用 --build-arg 覆盖
BP_GO_MIRROR=https://mirrors.aliyun.com/golang/
